FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y git curl libatomic1 --no-install-recommends \
&& apt-get clean
RUN CI=1 npm i -g corepack@latest @angular/cli@21

WORKDIR /app
COPY . .

RUN mkdir -p /app/node_modules /app/.pnpm-store && \
chown -R node:node /app /app/node_modules /app/.pnpm-store

USER node

EXPOSE 4201
